generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        BigInt   @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  currency  String?  @default("USD")
  users     User[]
  projects  Project[]
  invitations Invitation[]
}

model User {
  id        BigInt   @id @default(autoincrement())
  
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  hourlyRate Decimal? @db.Decimal(10,2)
  createdAt DateTime @default(now())
  
  organizationId BigInt?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  
  projectMemberships ProjectMembership[]
  sentInvitations    Invitation[]
  projects           Project[]          @relation("ProjectOwner")
  assignedTasks      TaskAssignment[]   @relation("TaskAssignee")
  createdAssignments TaskAssignment[]   @relation("AssignmentCreator")
  timeLogs           TimeLog[]
  createdTasks       Task[]             @relation("TaskCreator")
}

model Project {
  id          BigInt        @id @default(autoincrement())
  name        String
  description String?
  projectKey  String        @unique
  status      ProjectStatus @default(ACTIVE)
  lastTicketNumber Int       @default(0)
  createdAt   DateTime      @default(now())
  
  organizationId BigInt?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  memberships ProjectMembership[]

  ownerId   BigInt
  owner     User     @relation("ProjectOwner", fields: [ownerId], references: [id])

  tasks     Task[]
}

model ProjectMembership {
  id        BigInt     @id @default(autoincrement())
  projectId BigInt
  userId    BigInt
  joinedAt  DateTime   @default(now())
  leftAt    DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  role      String?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}
model Task {
  id          BigInt     @id @default(autoincrement())
  title       String
  ticketNumber Int
  status      TaskStatus @default(TODO)
  taskType    TaskType   @default(TASK)
  priority    Int @default(2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  createdBy   BigInt?
  creator     User? @relation("TaskCreator", fields: [createdBy], references: [id])

  projectId   BigInt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignments TaskAssignment[]
  timeLogs    TimeLog[]
}

model TaskAssignment {
  id        BigInt   @id @default(autoincrement())
  taskId    BigInt
  userId    BigInt
  assignedAt DateTime @default(now())
  assignedBy BigInt
  
  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assigner  User @relation("AssignmentCreator", fields: [assignedBy], references: [id])
  
  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@index([assignedBy])
}

model TimeLog {
  id        BigInt   @id @default(autoincrement())
  startTime DateTime @default(now())
  endTime   DateTime?
  duration  Int?
  title     String?

  userId    BigInt
  user      User     @relation(fields: [userId], references: [id])

  taskId    BigInt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, taskId])
}

model Invitation {
  id        BigInt    @id @default(autoincrement())
  email     String
  role      Role      @default(USER)
  orgId     BigInt
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy BigInt

  organization Organization @relation(fields: [orgId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])

  @@index([token])
}
enum Role {
  ADMIN
  USER
  MANAGER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskType {
  TASK
  BUG
  FEAT
  IMPR
}